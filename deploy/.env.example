# Copy to .env and fill in. Never commit .env.

# The server's address (a DNS A record must point here before starting).
DOMAIN=habits.example.com

# Required to create an account. Share it only with people you want on your server.
SIGNUP_CODE=change-me-to-something-long

# Contact address push services can reach about this server (Apple requires one).
VAPID_SUBJECT=mailto:you@example.com

# Email (optional; see DEPLOY.md "Email"). Leave SMTP_URL unset to keep email off.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# EMAIL_FROM=Habit Tracker <habits@yourdomain.com>

# The web app's address (no trailing slash). Add more, comma-separated, if needed.
ALLOWED_ORIGINS=https://mastertemple.github.io
